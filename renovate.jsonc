{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 0,
  // Every Renovate pull request is merged like any other pull request, after
  // the repository owner authorizes it — see docs/deployment.md (Dependency
  // Updates).
  "automerge": false,
  // Fix PRs raised from GitHub vulnerability (Dependabot) alerts. They bypass
  // the weekly schedule and the minimum release age of Renovate by design.
  // Requires Dependabot alerts and read access to them for the Mend Renovate
  // App. fix(deps): makes a merged security fix a release signal (patch) for
  // release-please, whereas routine ci(deps): and chore(deps): updates never
  // cut a release on their own. Renovate appends alert rules after
  // packageRules, so this prefix overrides the prefixes below. The topic
  // drops the word "dependency", so that the title with its [SECURITY] suffix
  // stays within the length that the PR Metadata check allows.
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "commitMessagePrefix": "fix(deps):",
    "commitMessageTopic": "{{depName}}"
  },
  // Weekly regeneration of package-lock.json, which keeps the transitive npm
  // dependencies current. Runs on the default "before 4am on monday"
  // schedule, aligned with schedule:earlyMondays above.
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessagePrefix": "chore(deps):"
  },
  // The npm settings of Renovate's lockfile updates: a copy of .npmrc, keep
  // both in sync. The only difference is allow-remote=all: under
  // allow-remote=none, `npm install --package-lock-only` refuses the registry
  // tarball of a package that declares bundleDependencies (npm/cli#9800).
  // Installs still use .npmrc, so CI refuses a URL dependency in the
  // lockfile. Remove both settings once an npm release of the line below
  // fixes the bug — see docs/deployment.md (Dependency Updates).
  "npmrc": "min-release-age=7\ninstall-strategy=linked\nallow-git=none\nallow-remote=all\nengine-strict=true\nsave-exact=true\n",
  "npmrcMerge": false,
  // The npm line of the tooling image (scripts/tooling.sh), so that Renovate
  // writes the lockfile as a local `scripts/tooling.sh npm` command would.
  // It changes with the Node.js line in package.json (engines).
  "constraints": {
    "npm": "11.x"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Supported Sentinel version of contract/sentinel-version, from Sentinel's GitHub Releases",
      "managerFilePatterns": ["/^contract/sentinel-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "vulnwatch/sentinel",
      // Release tags carry a 'v' prefix (v0.11.0) that the file omits.
      "extractVersionTemplate": "^v(?<version>\\d.*)$"
    },
    {
      "customType": "regex",
      "description": "Tooling image of scripts/tooling.sh, by version and digest",
      "managerFilePatterns": ["/^scripts/tooling\\.sh$/"],
      "matchStrings": [
        "TOOLING_IMAGE=\"mcr\\.microsoft\\.com/playwright:(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "mcr.microsoft.com/playwright"
    },
    {
      "customType": "regex",
      "description": "Images of the tools that the scripts run: shellcheck, shfmt, and actionlint in scripts/lint-shell.sh, and Trivy in scripts/image.sh, by version and digest",
      "managerFilePatterns": ["/^scripts/(lint-shell|image)\\.sh$/"],
      // The package name omits docker.io/, the default registry, so that the
      // titles of the version updates stay within the length that the PR
      // Metadata check allows.
      "matchStrings": [
        "[A-Z]+_IMAGE=\"docker\\.io/(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Renovate validation container used by the advisory pull-request workflow",
      "managerFilePatterns": ["/^\\.github/workflows/renovate-validation\\.yml$/"],
      "matchStrings": [
        "RENOVATE_IMAGE:\\s+renovate/renovate:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "renovate/renovate"
    },
    {
      "customType": "regex",
      "description": "Action version: inputs that the github-actions manager does not track (e.g. the Codecov CLI of codecov/codecov-action in ci.yml), each marked by a '# renovate: datasource=<datasource> depName=<name>' hint comment directly above it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s+version:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "GitHub Actions updates: the commit SHA and its version comment",
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "description": "Images and tools that the workflows pin, used only by CI",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/**"],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "description": "Tooling image and images of the tools that the scripts run, used locally and in CI",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["scripts/tooling.sh", "scripts/lint-shell.sh", "scripts/image.sh"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      // A base image update that fixes a vulnerability that the image scan
      // reports is merged with a fix(deps): subject instead, set when
      // squash-merging — see docs/deployment.md (Workflow Inventory, Image
      // vulnerability scan) and docs/conventions.md (Workflow, Squash merge).
      "description": "Base image of the Containerfile, which ships in the UI's image",
      "matchManagers": ["dockerfile"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      // Sentinel's image names its version and digest through variables, and
      // the UI's image is built locally, so the manager skips both: the
      // supported version changes in contract/sentinel-version (below), and
      // scripts/sentinel-contract.sh pins its digest — see docs/deployment.md
      // (Dependency Updates).
      "description": "PostgreSQL, Redis, and nginx images of compose.yaml, which runs the backend of local development, the end-to-end tests, and the local preview",
      "matchManagers": ["docker-compose"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      // The reverse proxy of compose.yaml runs the base image of the
      // Containerfile, so both references change together.
      "description": "nginx: the base image of the Containerfile and the proxy image of compose.yaml in one pull request",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchPackageNames": ["/(^|/)nginxinc/nginx-unprivileged$/"],
      "groupName": "nginx"
    },
    {
      "description": "npm dependencies, which reach the browser or run in the tooling",
      "matchManagers": ["npm"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      // The minimum release age of docs/architecture.md (Build Tool, Package
      // Manager, and Node.js). Only these update types carry a release
      // timestamp; npm's min-release-age covers the others, such as lock file
      // maintenance, when it resolves the lockfile.
      "description": "npm updates wait for the minimum release age",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "npm minor and patch updates in one pull request; each major update gets its own",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch dependencies"
    },
    {
      // After the group above, which it overrides. Its pull request needs the
      // API client regenerated on its branch, which the Mend Renovate App
      // cannot do, so it holds back no other update — see
      // docs/deployment.md (Dependency Updates).
      "description": "Orval in its own pull request",
      "matchManagers": ["npm"],
      "matchPackageNames": ["orval"],
      "groupName": "Orval"
    },
    {
      // A change of the supported Sentinel version carries a release signal,
      // so that the next UI release supports the new version, and it is
      // raised at once, before every other update when Renovate limits the
      // pull requests that it opens in an hour, because a Sentinel host
      // deploys the two together — see docs/architecture.md (Backend
      // Contract) and docs/deployment.md (Dependency Updates).
      "description": "Supported Sentinel version: feat(deps):, outside the weekly schedule, first",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["contract/sentinel-version"],
      "commitMessagePrefix": "feat(deps):",
      "commitMessageTopic": "Sentinel",
      "schedule": ["at any time"],
      "prPriority": 10
    },
    {
      // An override forces a fixed version on a dependent that does not allow
      // it, so a new major version could break that dependent — see
      // docs/deployment.md (Dependency Updates).
      "description": "npm overrides: no major update, which could break the dependent of the overridden version",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "The Node.js line follows the tooling image (docs/architecture.md, Build Tool, Package Manager, and Node.js) and changes by hand",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "The npm line of constraints.npm above follows the tooling image and changes by hand, with the Node.js line",
      "matchManagers": ["renovate-config"],
      "matchDepNames": ["npm"],
      "enabled": false
    },
    {
      // Its minor and patch updates join the group of the npm minor and
      // patch dependencies above — see docs/deployment.md (Dependency
      // Updates).
      "description": "The major version of @types/node, the types of the Node.js line, changes by hand, with that line",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // Last, so that it overrides the groups above and the playwright
      // monorepo group of config:recommended. The image has no release
      // timestamp, so Renovate raises its update at once and adds
      // @playwright/test when that version reaches the minimum release age.
      "description": "Playwright: the tooling image and @playwright/test in one pull request, so that the browsers of the image are the ones that Playwright expects",
      "matchPackageNames": ["mcr.microsoft.com/playwright", "@playwright/test"],
      "groupName": "Playwright"
    }
  ]
}
