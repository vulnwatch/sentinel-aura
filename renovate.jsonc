{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  // Routine updates open every night before 06:00 UTC, within a day of
  // reaching the minimum release age. The App schedules a run of the
  // repository every four hours, but its runs drift, so the window is six
  // hours long, enough to hold a run even when one is late — see
  // docs/deployment.md (Dependency Updates).
  "schedule": ["* 0-5 * * *"],
  // No limit on the pull requests that Renovate opens in an hour (2 by
  // default) or keeps open: the window may hold a single run, so a limit
  // would defer the other updates that are ready to the next window.
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  // Every Renovate pull request is merged like any other pull request, after
  // the repository owner authorizes it — see docs/deployment.md (Dependency
  // Updates).
  "automerge": false,
  // Fix PRs raised from GitHub vulnerability (Dependabot) alerts. They bypass
  // the schedule and the minimum release age of Renovate by design.
  // Requires Dependabot alerts and read access to them for the Mend Renovate
  // App. fix(deps): makes a merged security fix a release signal (patch) for
  // release-please, whereas routine ci(deps): and chore(deps): updates never
  // cut a release on their own. Renovate appends alert rules after
  // packageRules, so this prefix overrides the prefixes below. The topic
  // drops the word "dependency", so that the title with its [SECURITY] suffix
  // stays within the length that the PR Metadata check allows.
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "commitMessagePrefix": "fix(deps):",
    "commitMessageTopic": "{{depName}}"
  },
  // Weekly regeneration of package-lock.json, which keeps the transitive npm
  // dependencies current: in the window of the schedule above, on Monday
  // only, because a nightly regeneration would open a pull request almost
  // every night that conflicts with the npm group on the same file.
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessagePrefix": "chore(deps):",
    "schedule": ["* 0-5 * * 1"]
  },
  // The npm settings of Renovate's lockfile updates: a copy of .npmrc, keep
  // both in sync. The only difference is allow-remote=all: under
  // allow-remote=none, `npm install --package-lock-only` refuses the registry
  // tarball of a package that declares bundleDependencies (npm/cli#9800).
  // Installs still use .npmrc, so CI refuses a URL dependency in the
  // lockfile. Remove both settings once an npm release of the line below
  // fixes the bug — see docs/deployment.md (Dependency Updates).
  "npmrc": "min-release-age=7\ninstall-strategy=linked\nallow-git=none\nallow-remote=all\nengine-strict=true\nsave-exact=true\n",
  "npmrcMerge": false,
  // The npm line of the tooling image (scripts/tooling.sh), so that Renovate
  // writes the lockfile as a local `scripts/tooling.sh npm` command would.
  // It changes with the Node.js line in package.json (engines).
  "constraints": {
    "npm": "11.x"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned Sentinel version of contract/sentinel-version, from Sentinel's GitHub Releases",
      "managerFilePatterns": ["/^contract/sentinel-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "vulnwatch/sentinel",
      // Release tags carry a 'v' prefix (v0.11.0) that the file omits.
      "extractVersionTemplate": "^v(?<version>\\d.*)$"
    },
    {
      "customType": "regex",
      "description": "Tooling image of scripts/tooling.sh, by version and digest",
      "managerFilePatterns": ["/^scripts/tooling\\.sh$/"],
      "matchStrings": [
        "TOOLING_IMAGE=\"mcr\\.microsoft\\.com/playwright:(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "mcr.microsoft.com/playwright"
    },
    {
      "customType": "regex",
      "description": "Images of the tools that the scripts run: shellcheck, shfmt, and actionlint in scripts/lint-shell.sh, and Trivy in scripts/image.sh, by version and digest",
      "managerFilePatterns": ["/^scripts/(lint-shell|image)\\.sh$/"],
      // The package name omits docker.io/, the default registry, so that the
      // titles of the version updates stay within the length that the PR
      // Metadata check allows.
      "matchStrings": [
        "[A-Z]+_IMAGE=\"docker\\.io/(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Renovate validation container used by the advisory pull-request workflow",
      "managerFilePatterns": ["/^\\.github/workflows/renovate-validation\\.yml$/"],
      "matchStrings": [
        "RENOVATE_IMAGE:\\s+renovate/renovate:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "renovate/renovate"
    },
    {
      "customType": "regex",
      "description": "Action version: inputs that the github-actions manager does not track (e.g. the Codecov CLI of codecov/codecov-action in ci.yml), each marked by a '# renovate: datasource=<datasource> depName=<name>' hint comment directly above it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s+version:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      // The minimum release age of docs/architecture.md (Build Tool, Package
      // Manager, and Node.js), for the version updates of every manager —
      // see docs/deployment.md (Dependency Updates, Minimum release age).
      // Digest updates are not held: Docker Hub dates a digest by the last
      // push of its tag. Nor is lock file maintenance, which npm's
      // min-release-age covers when it resolves the lockfile. A version
      // without a release timestamp is held until it is requested from the
      // Dependency Dashboard. The nginx group, the pinned Sentinel version,
      // and the tooling image are exempt below.
      "description": "Version updates wait for the minimum release age",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "GitHub Actions updates: the commit SHA and its version comment",
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "description": "Images and tools that the workflows pin, used only by CI",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/**"],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "description": "Tooling image and images of the tools that the scripts run, used locally and in CI",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["scripts/tooling.sh", "scripts/lint-shell.sh", "scripts/image.sh"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      // A base image update that fixes a vulnerability that the image scan
      // reports is merged with a fix(deps): subject instead, set when
      // squash-merging — see docs/deployment.md (Workflow Inventory, Image
      // vulnerability scan) and docs/conventions.md (Workflow, Squash merge).
      "description": "Base image of the Containerfile, which ships in the UI's image",
      "matchManagers": ["dockerfile"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      // Sentinel's image names its version and digest through variables, and
      // the UI's image is built locally, so the manager skips both: the
      // pinned version changes in contract/sentinel-version (below), and
      // scripts/sentinel-contract.sh pins its digest — see docs/deployment.md
      // (Dependency Updates).
      "description": "PostgreSQL, Redis, and nginx images of compose.yaml, which runs the backend of local development, the end-to-end tests, and the local preview",
      "matchManagers": ["docker-compose"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      // Renovate's default topic of a digest update also names the tag
      // (<image>:<tag> Docker digest), which can take the title beyond the
      // length that the PR Metadata check allows — see docs/deployment.md
      // (Dependency Updates).
      "description": "Docker digest updates name the image without its tag",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "commitMessageTopic": "{{{depName}}} Docker digest"
    },
    {
      // The reverse proxy of compose.yaml runs the base image of the
      // Containerfile, so both references change together. Exempt from the
      // minimum release age: upstream rebuilds every current tag each week,
      // and Docker Hub dates a version by the last push of its tag, so the
      // newest version would never reach the age — see docs/deployment.md
      // (Dependency Updates, Minimum release age). groupSingleUpdates titles
      // its pull request "Update nginx" also when it holds a single update,
      // because the title that names the image would exceed the length that
      // the PR Metadata check allows.
      "description": "nginx: the base image of the Containerfile and the proxy image of compose.yaml in one pull request, titled by the group, without the minimum release age",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchPackageNames": ["/(^|/)nginx/nginx-unprivileged$/"],
      "groupName": "nginx",
      "groupSingleUpdates": true,
      "minimumReleaseAge": null
    },
    {
      "description": "npm dependencies, which reach the browser or run in the tooling",
      "matchManagers": ["npm"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "npm minor and patch updates in one pull request; each major update gets its own",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch dependencies"
    },
    {
      // After the group above, which it overrides. Its pull request needs the
      // API client regenerated on its branch, which the Mend Renovate App
      // cannot do, so it holds back no other update — see
      // docs/deployment.md (Dependency Updates).
      "description": "Orval in its own pull request",
      "matchManagers": ["npm"],
      "matchPackageNames": ["orval"],
      "groupName": "Orval"
    },
    {
      // Every Sentinel release is raised at once, without the minimum release
      // age, before every routine update: one outside the supported Sentinel
      // versions of the current pin needs a UI release before a Sentinel host
      // can deploy it, and one within them keeps the pin and the end-to-end
      // tests on Sentinel's latest release — see docs/architecture.md
      // (Backend Contract) and docs/deployment.md (Dependency Updates). A
      // change within those versions carries no release signal; the two
      // rules below give the others one.
      "description": "Pinned Sentinel version: chore(deps):, outside the schedule and the minimum release age, first",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["contract/sentinel-version"],
      "commitMessagePrefix": "chore(deps):",
      "commitMessageTopic": "Sentinel",
      "schedule": ["at any time"],
      "minimumReleaseAge": null,
      "prPriority": 10
    },
    {
      // A major update leaves the supported Sentinel versions of the current
      // pin, so it carries a release signal, so that the next UI release
      // supports the new version.
      "description": "Pinned Sentinel version, major update: feat(deps):",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["contract/sentinel-version"],
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "feat(deps):"
    },
    {
      // Before Sentinel 1.0.0, a minor update leaves them too. The manager
      // uses semver-coerced versioning, which reads a range such as "<1.0.0"
      // in matchCurrentVersion as a version, so a regular expression selects
      // the pins below 1.0.0.
      "description": "Pinned Sentinel version, minor update below 1.0.0: feat(deps):",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["contract/sentinel-version"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^0\\./",
      "commitMessagePrefix": "feat(deps):"
    },
    {
      // An override forces a fixed version on a dependent that does not allow
      // it, so a new major version could break that dependent — see
      // docs/deployment.md (Dependency Updates).
      "description": "npm overrides: no major update, which could break the dependent of the overridden version",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "The Node.js line follows the tooling image (docs/architecture.md, Build Tool, Package Manager, and Node.js) and changes by hand",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "The npm line of constraints.npm above follows the tooling image and changes by hand, with the Node.js line",
      "matchManagers": ["renovate-config"],
      "matchDepNames": ["npm"],
      "enabled": false
    },
    {
      // Its minor and patch updates join the group of the npm minor and
      // patch dependencies above — see docs/deployment.md (Dependency
      // Updates).
      "description": "The major version of @types/node, the types of the Node.js line, changes by hand, with that line",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // Last but one, so that it overrides the groups above and the
      // playwright monorepo group of config:recommended. Renovate raises the
      // update of the image at once (below) and adds @playwright/test when
      // that version reaches the minimum release age. groupSingleUpdates
      // titles the pull request "Update Playwright" also when it holds the
      // image alone, whose own title would exceed the length that the PR
      // Metadata check allows.
      "description": "Playwright: the tooling image and @playwright/test in one pull request, so that the browsers of the image are the ones that Playwright expects; titled by the group",
      "matchPackageNames": ["mcr.microsoft.com/playwright", "@playwright/test"],
      "groupName": "Playwright",
      "groupSingleUpdates": true
    },
    {
      // mcr.microsoft.com publishes no release timestamps, so the minimum
      // release age would hold the image indefinitely and leave the group
      // above without it — see docs/deployment.md (Dependency Updates).
      "description": "The tooling image is exempt from the minimum release age",
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "minimumReleaseAge": null
    }
  ]
}
