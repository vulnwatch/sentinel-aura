#!/usr/bin/env bash
# pre-commit hook: fast local checks on the staged files.
#
# - scripts/lint-shell.sh on the staged files: shellcheck and shfmt on the
#   staged shell scripts and Git hooks, and actionlint on the staged
#   workflows, selected like the Shell Lint job of .github/workflows/ci.yml
#   selects the tracked ones
# - gitleaks on the staged changes
#
# A missing tool produces a warning and does not block the commit. CI is the
# authoritative gate for the shell and workflow checks; no workflow scans for
# secrets. See docs/deployment.md (Local Git Hooks).
set -euo pipefail

# shellcheck source=scripts/lib/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/../scripts/lib/common.sh"

main() {
    echo "Running pre-commit checks..."
    "${REPO_ROOT}/scripts/lint-shell.sh" --staged
    run_if_installed "local-only check" gitleaks git --staged
}

main "$@"
