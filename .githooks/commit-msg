#!/usr/bin/env bash
# commit-msg hook: validate the first line of a commit message against
# docs/conventions.md (Commit Messages), with the rules of
# scripts/lib/commit-title.sh, which scripts/check-pr-metadata.sh applies to
# the title of a pull request. Messages that Git generates (Merge, Revert,
# fixup!, squash!) are skipped.
#
# Usage: Git runs the hook with the path of the message file. Activation:
# docs/deployment.md (Local Git Hooks).
set -euo pipefail

# shellcheck source=scripts/lib/commit-title.sh
source "$(dirname "${BASH_SOURCE[0]}")/../scripts/lib/commit-title.sh"

readonly GENERATED_PATTERN='^(Merge|Revert|fixup!|squash!)'

main() {
    local subject problem
    subject=$(head -n 1 "$1")

    if [[ "${subject}" =~ ${GENERATED_PATTERN} ]]; then
        return 0
    fi

    if ! problem="$(title_problem "${subject}")"; then
        {
            echo "Error: the first line of the commit message ${problem}."
            echo "  Got: ${subject}"
        } >&2
        return 1
    fi
}

main "$@"
