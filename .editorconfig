root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml}]
indent_style = space
indent_size = 2

[*.{ts,tsx,js,mjs,cjs,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Shell scripts and Git hooks, whose settings shfmt reads (docs/conventions.md,
# Shell Scripting). A glob with a slash is relative to this directory, so the
# hooks have their own section.
[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true

[.githooks/*]
indent_style = space
indent_size = 4
switch_case_indent = true
