; npm settings: docs/architecture.md (Build Tool, Package Manager, and Node.js).
; Allowing an install script or a version younger than the minimum release age
; requires the decision in docs/conventions.md (Dependency Admission).
; renovate.jsonc (npmrc) holds a copy of these settings for Renovate's lockfile
; updates: keep both in sync.
min-release-age=7
install-strategy=linked
allow-git=none
allow-remote=none
engine-strict=true
save-exact=true
